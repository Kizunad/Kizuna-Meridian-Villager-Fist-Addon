# 袖手拳功法目录，schema_version 同时标识清单格式。
# 上卷外家：崩拳、撩天、背摔三式打人，打木桩练两臂耐力。
# 中卷内家：寸劲、缠腕（十字手做好再放进来）；有卷轴物品但不掉落，生存里只在武馆学。下卷等各自的式做好再加卷。
schema_version: 1
namespace: "meridian_villager"
binding_templates { id: "human:adult" version: 1 }

books {
  id: "meridian_villager:sleeve_fist"
  display_name: "袖手拳"
  arm_rules {
    ignore_held_items: true
    require_grounded: false
    base_damage { value: 3 unit: DAMAGE_POINT }
  }
}

volumes {
  id: "meridian_villager:outer"
  book_id: "meridian_villager:sleeve_fist"
  display_name: "袖手拳·上卷·外家"
  techniques { id: "meridian_villager:crushing_fist" version: 1 }
  techniques { id: "meridian_villager:golem_lift" version: 1 }
  techniques { id: "meridian_villager:shoulder_throw" version: 1 }
  techniques { id: "meridian_villager:dummy_drill" version: 1 }
  scroll_drops { entity_type: "minecraft:villager" chance: 0.25 }
}

volumes {
  id: "meridian_villager:inner"
  book_id: "meridian_villager:sleeve_fist"
  display_name: "袖手拳·中卷·内家"
  techniques { id: "meridian_villager:inch_power" version: 1 }
  techniques { id: "meridian_villager:wrist_lock" version: 1 }
  prerequisite_volume_ids: "meridian_villager:outer"
  # 中卷只在武馆传（用户 10-31）：卷轴物品只为创造模式方便拿（用户 11-18），不写 scroll_drops，生存里没有来路。
}

definitions {
  id: "meridian_villager:crushing_fist"
  version: 1
  ai_hints {
    minimum_distance { value: 0 unit: METER }
    maximum_distance { value: 2.5 unit: METER }
    maximum_hp_ratio { value: 1 unit: RATIO }
    minimum_qi_ratio { value: 0 unit: RATIO }
    category_weight { value: 1 unit: RATIO }
    # 生物选式：拳打在盾上会被挡，对方举盾时让给背摔；被围时让给撩天；对方倒地时补一拳。
    # 「让给」写成极小的权重而不是零：该出的那一式在冷却或放不出时，这一式还能出，不至于判了出手却选不出式。
    combat {
      target_shielding_weight { value: 0.0001 unit: RATIO }
      surrounded_weight { value: 0.0001 unit: RATIO }
      target_downed_weight { value: 3 unit: RATIO }
    }
  }
  category: ATTACK
  minimum_realm: WANDERING_QI
  slots { id: "arm_muscles" module: TISSUE tags: "human:arm_muscle" minimum_count: 6 maximum_count: 6 }
  slots { id: "leg_muscles" module: TISSUE tags: "human:leg_muscle" minimum_count: 6 maximum_count: 6 }
  cost {
    work {
      slot_id: "arm_muscles" force { value: 0 unit: NEWTON }
      power { value: 66.67 unit: WATT } duration { value: 0.3 unit: SECOND }
    }
    work {
      slot_id: "leg_muscles" force { value: 0 unit: NEWTON }
      power { value: 50 unit: WATT } duration { value: 0.3 unit: SECOND }
    }
  }
  phases { warmup_millis: 1000 active_millis: 0 recovery_millis: 2000 interruptible_by_damage: false }
  cooldown_millis: 1000
  effects {
    at_millis: 0
    presentation { id: "meridian_villager:villager_crushing_fist" duration: UNTIL_RECOVERY_END start_millis: 0 }
  }
  effects { at_millis: 750 impulse { direction: FORWARD speed { value: 3 unit: METERS_PER_SECOND } } }
  effects {
    at_millis: 1000
    limb_strike {
      shape: SINGLE_TARGET
      facing: STRIKE_FORWARD
      distance { value: 2.5 unit: METER }
      angle { value: 60 unit: DEGREE }
      multiplier { value: 1.4 unit: RATIO }
      maximum_targets: 1
      cast_target_limit: 1
      arm: REAR_ARM
      damage_type_id: "meridian_villager:fist_rear_torso"
      knockback_kind: PUSH
      knockback { value: 0.6 unit: RATIO }
      knockback_when_blocked: true
      last_strike: true
      dedup_group: "crushing_fist"
    }
  }
  effects {
    at_millis: 1000
    sound {
      sound_id: "minecraft:entity.player.attack.strong" anchor: TARGET
      volume { value: 1 unit: RATIO } pitch { value: 0.9 unit: RATIO } pitch_jitter { value: 0.05 unit: RATIO }
    }
  }
  presentation {
    icon_id: "meridian_villager:crushing_fist"
    display_name: "崩拳"
    description: "村口的老拳师从不说这一拳叫什么，只叫徒弟跟着他的脚走：前脚蹭出去半步，后脚贴着地追上来，拳眼朝天从心口直直送出。徒弟们练了一冬，才听懂他那句“像弓弦崩断”的意思。"
  }
  movement_speed_multiplier: 0.4
  follow_up {
    transitions {
      previous { id: "meridian_villager:golem_lift" version: 1 }
      recovery_start_ratio { value: 0.5 unit: RATIO }
      after_recovery_millis: 500
      start_millis: 300
    }
  }
}

definitions {
  id: "meridian_villager:golem_lift"
  version: 1
  ai_hints {
    minimum_distance { value: 0 unit: METER }
    maximum_distance { value: 2.5 unit: METER }
    maximum_hp_ratio { value: 1 unit: RATIO }
    minimum_qi_ratio { value: 0 unit: RATIO }
    category_weight { value: 1 unit: RATIO }
    # 生物选式：被围时优先用它把人掀开；对方举盾时让给背摔（极小的权重，理由同崩拳）。
    combat {
      target_shielding_weight { value: 0.0001 unit: RATIO }
      surrounded_weight { value: 8 unit: RATIO }
    }
  }
  category: ATTACK
  minimum_realm: WANDERING_QI
  slots { id: "arm_muscles" module: TISSUE tags: "human:arm_muscle" minimum_count: 6 maximum_count: 6 }
  slots { id: "leg_muscles" module: TISSUE tags: "human:leg_muscle" minimum_count: 6 maximum_count: 6 }
  cost {
    work {
      slot_id: "arm_muscles" force { value: 0 unit: NEWTON }
      power { value: 116.67 unit: WATT } duration { value: 0.4 unit: SECOND }
    }
    work {
      slot_id: "leg_muscles" force { value: 0 unit: NEWTON }
      power { value: 100 unit: WATT } duration { value: 0.4 unit: SECOND }
    }
  }
  phases { warmup_millis: 1900 active_millis: 0 recovery_millis: 3100 interruptible_by_damage: true }
  cooldown_millis: 4000
  effects {
    at_millis: 0
    presentation { id: "meridian_villager:villager_golem_lift" duration: UNTIL_RECOVERY_END start_millis: 0 }
  }
  effects {
    at_millis: 1900
    limb_strike {
      shape: SINGLE_TARGET
      facing: STRIKE_FORWARD
      distance { value: 2.5 unit: METER }
      angle { value: 60 unit: DEGREE }
      multiplier { value: 1.5 unit: RATIO }
      maximum_targets: 1
      cast_target_limit: 1
      arm: BOTH_ARMS
      damage_type_id: "meridian_villager:fist_uppercut"
      knockback_kind: LIFT
      knockback { value: 0.3 unit: RATIO }
      lift_speed { value: 8 unit: METERS_PER_SECOND }
      knockback_when_blocked: true
      last_strike: true
      dedup_group: "golem_lift"
    }
  }
  effects {
    at_millis: 1900
    sound {
      sound_id: "minecraft:entity.player.attack.strong" anchor: TARGET
      volume { value: 1 unit: RATIO } pitch { value: 0.8 unit: RATIO } pitch_jitter { value: 0.05 unit: RATIO }
    }
  }
  effects {
    at_millis: 1900
    sound {
      sound_id: "minecraft:entity.iron_golem.attack" anchor: TARGET
      volume { value: 1 unit: RATIO } pitch { value: 1 unit: RATIO } pitch_jitter { value: 0.05 unit: RATIO }
    }
  }
  presentation {
    icon_id: "meridian_villager:golem_lift"
    display_name: "撩天"
    description: "这一式是看铁傀儡守村看来的。那年掠夺者摸进村，傀儡两条胳膊垂到膝前，往上一抡，就把人掀过了屋檐。看热闹的村民里有一个从此天天对着草垛抡胳膊，后来村里再没人笑他。"
  }
  movement_speed_multiplier: 0.4
  follow_up {
    transitions {
      previous { id: "meridian_villager:crushing_fist" version: 1 }
      recovery_start_ratio { value: 0.5 unit: RATIO }
      after_recovery_millis: 500
      start_millis: 400
    }
  }
}

definitions {
  id: "meridian_villager:shoulder_throw"
  version: 1
  ai_hints {
    minimum_distance { value: 0 unit: METER }
    maximum_distance { value: 2 unit: METER }
    maximum_hp_ratio { value: 1 unit: RATIO }
    minimum_qi_ratio { value: 0 unit: RATIO }
    category_weight { value: 1 unit: RATIO }
    # 生物选式：擒不怕盾，对方举盾时优先出这一式；被围时让给撩天（极小的权重，理由同崩拳）。
    combat {
      target_shielding_weight { value: 4 unit: RATIO }
      surrounded_weight { value: 0.0001 unit: RATIO }
    }
  }
  category: ATTACK
  minimum_realm: WANDERING_QI
  slots { id: "arm_muscles" module: TISSUE tags: "human:arm_muscle" minimum_count: 6 maximum_count: 6 }
  slots { id: "leg_muscles" module: TISSUE tags: "human:leg_muscle" minimum_count: 6 maximum_count: 6 }
  cost {
    work {
      slot_id: "arm_muscles" force { value: 0 unit: NEWTON }
      power { value: 100 unit: WATT } duration { value: 1.4 unit: SECOND }
    }
    work {
      slot_id: "leg_muscles" force { value: 0 unit: NEWTON }
      power { value: 133.33 unit: WATT } duration { value: 1.4 unit: SECOND }
    }
  }
  phases { warmup_millis: 1200 active_millis: 1400 recovery_millis: 3400 interruptible_by_damage: true }
  cooldown_millis: 5000
  effects {
    at_millis: 0
    presentation { id: "meridian_villager:villager_shoulder_throw" duration: UNTIL_RECOVERY_END start_millis: 0 }
  }
  # 1.20 擒：2 格内抓一个拉到身前 1 格，擒到 2.20；摔不动的不擒，1.50 一靠（×0.4，推开 1.0）。
  effects {
    at_millis: 1200
    grapple {
      processor_id: "meridian_villager:grapple"
      maximum_distance { value: 2 unit: METER }
      hold_distance { value: 1 unit: METER }
      duration_millis: 1000
      lean {
        delay_millis: 300
        damage_type_id: "meridian_villager:throw"
        multiplier { value: 0.4 unit: RATIO }
        push { value: 1 unit: RATIO }
      }
    }
  }
  # 2.20 抛：0.40 s 过头，最高比头顶高 0.5 格；2.60 落在身后 2 格，打躯干 ×2.0，倒地 1.5 s，起来后 3 s 不再被摔倒。
  effects {
    at_millis: 2200
    throw {
      processor_id: "meridian_villager:grapple"
      flight_millis: 400
      landing_distance { value: 2 unit: METER }
      apex_height { value: 0.5 unit: METER }
      damage_type_id: "meridian_villager:throw"
      multiplier { value: 2 unit: RATIO }
      down_millis: 1500
      down_immunity_millis: 3000
    }
  }
  presentation {
    icon_id: "meridian_villager:shoulder_throw"
    display_name: "背摔"
    description: "老拳师说，人和麦捆一样，有个能扛的地方。抓住了，转身，矮下去，把他架上肩，剩下的交给他自己的分量。村里收麦的汉子学这一式最快，摔得也最响。"
  }
  movement_speed_multiplier: 0.4
}

definitions {
  id: "meridian_villager:inch_power"
  version: 1
  ai_hints {
    minimum_distance { value: 0 unit: METER }
    maximum_distance { value: 1.5 unit: METER }
    maximum_hp_ratio { value: 1 unit: RATIO }
    minimum_qi_ratio { value: 0 unit: RATIO }
    category_weight { value: 1 unit: RATIO }
    # 生物选式：劲透进去，护甲只算一半，对方被打的部位护甲高时优先出它；打在盾上整下被挡，对方举盾时让给背摔；
    # 被围时让给撩天（极小的权重，理由同崩拳）。
    combat {
      target_shielding_weight { value: 0.0001 unit: RATIO }
      surrounded_weight { value: 0.0001 unit: RATIO }
      target_armored_weight { value: 4 unit: RATIO }
    }
  }
  category: ATTACK
  minimum_realm: WANDERING_QI
  # 内家要游炁：至少开着一条手经才使得出（凡人一条经都没开）。不花真元，这个槽只当门槛。
  slots {
    id: "hand_meridians" module: MERIDIAN tags: "human:hand_meridian"
    minimum_count: 1 maximum_count: 1 require_opened: true
  }
  slots { id: "arm_muscles" module: TISSUE tags: "human:arm_muscle" minimum_count: 6 maximum_count: 6 }
  slots { id: "leg_muscles" module: TISSUE tags: "human:leg_muscle" minimum_count: 6 maximum_count: 6 }
  cost {
    work {
      slot_id: "arm_muscles" force { value: 0 unit: NEWTON }
      power { value: 100 unit: WATT } duration { value: 0.2 unit: SECOND }
    }
    work {
      slot_id: "leg_muscles" force { value: 0 unit: NEWTON }
      power { value: 100 unit: WATT } duration { value: 0.2 unit: SECOND }
    }
  }
  phases { warmup_millis: 1450 active_millis: 0 recovery_millis: 2550 interruptible_by_damage: false }
  cooldown_millis: 4000
  effects {
    at_millis: 0
    presentation { id: "meridian_villager:villager_inch_power" duration: UNTIL_RECOVERY_END start_millis: 0 }
  }
  # 1.45 前手贴身一抖：×1.6，劲透进去六成落在器官上，这一下局部护甲只算一半，不击退；正面打在盾上整下被挡。
  effects {
    at_millis: 1450
    limb_strike {
      shape: SINGLE_TARGET
      facing: STRIKE_FORWARD
      distance { value: 1.5 unit: METER }
      angle { value: 60 unit: DEGREE }
      multiplier { value: 1.6 unit: RATIO }
      maximum_targets: 1
      cast_target_limit: 1
      arm: FRONT_ARM
      damage_type_id: "meridian_villager:inch_power"
      knockback_kind: NONE
      knockback { value: 0 unit: RATIO }
      knockback_when_blocked: false
      last_strike: true
      dedup_group: "inch_power"
      penetration {
        organ_share { value: 0.6 unit: RATIO }
        armor_multiplier { value: 0.5 unit: RATIO }
      }
    }
  }
  effects {
    at_millis: 1450
    sound {
      sound_id: "minecraft:entity.player.attack.crit" anchor: TARGET
      volume { value: 1 unit: RATIO } pitch { value: 0.7 unit: RATIO } pitch_jitter { value: 0.05 unit: RATIO }
    }
  }
  presentation {
    icon_id: "meridian_villager:inch_power"
    display_name: "寸劲"
    description: "老拳师教这一拳，总叫人不用把手往回拉。拳头贴着人只隔一寸，从脚到拳浑身一抖，劲就全透进去了。外头看着没伤，人还立在原地，身上的甲也只能挡下一半，大半劲全落在脏腑里。可要是正面打在盾上，就半点也透不过去。"
  }
  movement_speed_multiplier: 0.4
}

definitions {
  id: "meridian_villager:wrist_lock"
  version: 1
  ai_hints {
    minimum_distance { value: 0 unit: METER }
    maximum_distance { value: 2 unit: METER }
    maximum_hp_ratio { value: 1 unit: RATIO }
    minimum_qi_ratio { value: 0 unit: RATIO }
    category_weight { value: 1 unit: RATIO }
    # 生物选式：拿的是手腕，举着盾也拿得住，但对着盾的第一式仍然让给背摔（极小的权重，理由同崩拳），
    # 背摔在冷却或放不出时它和崩拳一样能出；被围时让给撩天。
    combat {
      target_shielding_weight { value: 0.0001 unit: RATIO }
      surrounded_weight { value: 0.0001 unit: RATIO }
    }
  }
  category: ATTACK
  minimum_realm: WANDERING_QI
  # 内家要游炁：至少开着一条手经才使得出（凡人一条经都没开）。不花真元，这个槽只当门槛。
  slots {
    id: "hand_meridians" module: MERIDIAN tags: "human:hand_meridian"
    minimum_count: 1 maximum_count: 1 require_opened: true
  }
  slots { id: "arm_muscles" module: TISSUE tags: "human:arm_muscle" minimum_count: 6 maximum_count: 6 }
  cost {
    work {
      slot_id: "arm_muscles" force { value: 0 unit: NEWTON }
      power { value: 66.67 unit: WATT } duration { value: 1.6 unit: SECOND }
    }
  }
  phases { warmup_millis: 900 active_millis: 1600 recovery_millis: 2500 interruptible_by_damage: false }
  cooldown_millis: 5000
  effects {
    at_millis: 0
    presentation { id: "meridian_villager:villager_wrist_lock" duration: UNTIL_RECOVERY_END start_millis: 0 }
  }
  # 0.90 擒：2 格内抓一个拉到身前 1 格，擒到 2.50 放手；摔不动的只拧不擒。
  effects {
    at_millis: 900
    grapple {
      processor_id: "meridian_villager:grapple"
      maximum_distance { value: 2 unit: METER }
      hold_distance { value: 1 unit: METER }
      duration_millis: 1600
    }
  }
  # 1.40、2.10 两下拧：打对方拿着东西那一侧的前臂，×0.6、×0.9，那条手臂的肌肉麻 6 s；
  # 第二下拧掉对方主手的东西（玩家是攻击冷却清零、正在用的物品被打断）。拿的是关节，不吃盾、不击退。
  effects {
    at_millis: 1400
    limb_strike {
      shape: SINGLE_TARGET
      facing: STRIKE_FORWARD
      distance { value: 2 unit: METER }
      angle { value: 60 unit: DEGREE }
      multiplier { value: 0.6 unit: RATIO }
      maximum_targets: 1
      cast_target_limit: 1
      arm: BOTH_ARMS
      damage_type_id: "meridian_villager:joint_lock"
      knockback_kind: NONE
      knockback { value: 0 unit: RATIO }
      knockback_when_blocked: false
      last_strike: false
      dedup_group: "wrist_lock_first"
      armed_forearm: true
      attachments { numb { multiplier { value: 0.3 unit: RATIO } duration_millis: 6000 whole_arm: true } }
    }
  }
  effects {
    at_millis: 1400
    sound {
      sound_id: "minecraft:entity.player.attack.weak" anchor: TARGET
      volume { value: 1 unit: RATIO } pitch { value: 0.8 unit: RATIO } pitch_jitter { value: 0.05 unit: RATIO }
    }
  }
  effects {
    at_millis: 2100
    limb_strike {
      shape: SINGLE_TARGET
      facing: STRIKE_FORWARD
      distance { value: 2 unit: METER }
      angle { value: 60 unit: DEGREE }
      multiplier { value: 0.9 unit: RATIO }
      maximum_targets: 1
      cast_target_limit: 1
      arm: BOTH_ARMS
      damage_type_id: "meridian_villager:joint_lock"
      knockback_kind: NONE
      knockback { value: 0 unit: RATIO }
      knockback_when_blocked: false
      last_strike: true
      dedup_group: "wrist_lock_second"
      armed_forearm: true
      attachments { numb { multiplier { value: 0.3 unit: RATIO } duration_millis: 6000 whole_arm: true } }
      disarm: true
    }
  }
  effects {
    at_millis: 2100
    sound {
      sound_id: "minecraft:entity.player.attack.strong" anchor: TARGET
      volume { value: 1 unit: RATIO } pitch { value: 0.8 unit: RATIO } pitch_jitter { value: 0.05 unit: RATIO }
    }
  }
  presentation {
    icon_id: "meridian_villager:wrist_lock"
    display_name: "缠腕"
    description: "老拳师教擒拿，说管他举不举盾，一手刁住手腕、一手压在肘上，人就挣不开也走不脱。顺着关节反向拧他拿家伙的前臂，胳膊发麻，6 秒里都使不上力气；跟着再拧第二下，手里的家伙便脱手砸在地上。"
  }
  movement_speed_multiplier: 0.4
}

definitions {
  id: "meridian_villager:dummy_drill"
  version: 1
  ai_hints {
    minimum_distance { value: 0 unit: METER }
    maximum_distance { value: 2 unit: METER }
    maximum_hp_ratio { value: 1 unit: RATIO }
    minimum_qi_ratio { value: 0 unit: RATIO }
    category_weight { value: 0 unit: RATIO }
  }
  category: CULTIVATION
  minimum_realm: WANDERING_QI
  movement_speed_multiplier: 0
  slots { id: "arm_muscles" module: TISSUE tags: "human:arm_muscle" minimum_count: 6 maximum_count: 6 }
  cost {}
  phases { warmup_millis: 31000 active_millis: 0 recovery_millis: 1000 interruptible_by_damage: true }
  cooldown_millis: 43000
  effects {
    at_millis: 0
    presentation { id: "meridian_villager:villager_dummy_drill" duration: UNTIL_RECOVERY_END start_millis: 0 }
  }
  effects {
    at_millis: 1000
    block_work {
      processor_id: "meridian_villager:dummy_drill"
      block_tags: "meridian_villager:drill_targets"
      maximum_distance { value: 2 unit: METER }
      interval_millis: 500
      duration_millis: 30000
    }
  }
  effects {
    at_millis: 1000
    work {
      slot_id: "arm_muscles" force { value: 80 unit: NEWTON }
      power { value: 45 unit: WATT } duration { value: 6 unit: SECOND } training: true
    }
  }
  effects {
    at_millis: 7000
    work {
      slot_id: "arm_muscles" force { value: 80 unit: NEWTON }
      power { value: 45 unit: WATT } duration { value: 6 unit: SECOND } training: true
    }
  }
  effects {
    at_millis: 13000
